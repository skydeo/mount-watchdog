# Site configuration for mount-watchdog. Copy to config.env and edit:
#     cp config.env.example config.env && $EDITOR config.env
# config.env is gitignored (holds your host/user/share); this example is committed.

# --- NAS (SMB) ---
NAS_HOST="192.168.1.10"        # NAS IP or hostname
NAS_PORT="445"
NAS_USER="nasuser"             # SMB account; also the Keychain item's account
NAS_SHARE="media"              # SMB share name
NAS_MOUNT="/Volumes/media"     # where it mounts (Finder-style, macOS-managed)

# --- Containers to restart when the NAS mount is restored (space-separated) ---
NAS_CONTAINERS="jellyfin"

# --- Local SSD volumes (APFS) — one or more ---
# One entry per volume, fields separated by "|":
#     "<diskutil volume name>|<mountpoint>|<containers that bind it, space-separated>"
# The volume name is what `diskutil list` shows; the container list may be empty.
# When a volume is restored, only ITS containers are restarted (each container at most
# once per run, even if several targets recover together).
SSD_VOLUMES=(
  "FastSSD|/Volumes/FastSSD|jellyfin"
  "Scratch|/Volumes/Scratch|qbittorrent sabnzbd"
)

# Legacy single-SSD form (still works if SSD_VOLUMES is unset/empty): SSD_VOL + SSD_MOUNT,
# with DEPENDENT_CONTAINERS restarted for both the SSD and — if NAS_CONTAINERS is unset —
# the NAS.
#   SSD_VOL="FastSSD"
#   SSD_MOUNT="/Volumes/FastSSD"
#   DEPENDENT_CONTAINERS="jellyfin"

# --- Dedicated Keychain item holding the NAS password (account = NAS_USER) ---
KEYCHAIN_SERVICE="mount-watchdog-nas"

# --- LaunchAgent label (reverse-DNS); used to name the plist + launchctl job ---
AGENT_LABEL="com.example.mount-watchdog"
